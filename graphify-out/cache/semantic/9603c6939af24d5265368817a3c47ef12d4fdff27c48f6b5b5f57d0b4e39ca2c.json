{"nodes": [{"id": "PRD_remisense_ai", "label": "RemiSense AI Product Requirements", "file_type": "document", "source_file": "PRD.md", "source_location": null, "source_url": null, "captured_at": "2026-05-24", "author": null, "contributor": null}, {"id": "PRD_heuristic_formula", "label": "Heuristic Card Scoring Formula", "file_type": "rationale", "source_file": "PRD.md", "source_location": "385-398", "source_url": null, "captured_at": "2026-05-24", "author": null, "contributor": null, "rationale": "Card Score = (comboPotential \u00d7 40) + (completionChance \u00d7 30) + (flexibility \u00d7 20) - (deadRisk \u00d7 25) - (highPointPenalty \u00d7 10). Balances offensive potential against defensive risk."}, {"id": "PRD_joker_mechanism", "label": "Joker Mechanism (Rank-Based Wildcard)", "file_type": "rationale", "source_file": "PRD.md", "source_location": "234-242", "source_url": null, "captured_at": "2026-05-24", "author": null, "contributor": null, "rationale": "Joker is NOT a separate card. Determined at game start: one card drawn blindly reveals its rank, all 4 cards of that rank become wildcards. Indicator card is placed separately, owned by no one."}, {"id": "PRD_strategic_explainability", "label": "Strategic Explainability Principle", "file_type": "rationale", "source_file": "PRD.md", "source_location": "760-764", "source_url": null, "captured_at": "2026-05-24", "author": null, "contributor": null, "rationale": "Product strength is 'strategic explainability' not AI hype. Prioritize explainable recommendations, deterministic logic, fast response, clean architecture."}, {"id": "PRD_recommendation_priorities", "label": "Recommendation Priority Order", "file_type": "rationale", "source_file": "PRD.md", "source_location": "400-408", "source_url": null, "captured_at": "2026-05-24", "author": null, "contributor": null, "rationale": "Priority: 1) Preserve completed melds, 2) Preserve high-probability near melds, 3) Remove dead high cards, 4) Remove low synergy cards, 5) Minimize future penalty."}, {"id": "PRD_source_paper", "label": "Source Paper: Strategi Greedy pada Permainan Kartu Remi", "file_type": "paper", "source_file": "PRD.md", "source_location": "3", "source_url": "https://informatika.stei.itb.ac.id/~rinaldi.munir/Stmik/2020-2021/Makalah2021/Makalah-Stima-2021-K3%20(9).pdf", "captured_at": "2026-05-24", "author": null, "contributor": null}, {"id": "PRD_pure_client_architecture", "label": "Pure Client-Side SPA Architecture", "file_type": "rationale", "source_file": "PRD.md", "source_location": "416-448", "source_url": null, "captured_at": "2026-05-24", "author": null, "contributor": null, "rationale": "All engine logic runs client-side as pure TypeScript functions. No external AI APIs required. Offline-capable logic preferred. Engine must be framework-independent."}], "edges": [{"source": "PRD_remisense_ai", "target": "PRD_source_paper", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PRD.md", "source_location": "3", "weight": 1.0}, {"source": "PRD_heuristic_formula", "target": "PRD_remisense_ai", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PRD.md", "source_location": "385", "weight": 1.0}, {"source": "PRD_joker_mechanism", "target": "PRD_remisense_ai", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PRD.md", "source_location": "234", "weight": 1.0}, {"source": "PRD_strategic_explainability", "target": "PRD_remisense_ai", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PRD.md", "source_location": "760", "weight": 1.0}, {"source": "PRD_recommendation_priorities", "target": "PRD_remisense_ai", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PRD.md", "source_location": "400", "weight": 1.0}, {"source": "PRD_pure_client_architecture", "target": "PRD_remisense_ai", "relation": "rationale_for", "